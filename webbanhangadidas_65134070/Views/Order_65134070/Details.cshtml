@model webbanhangadidas_65134070.Models.Don_Hang

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h3 class="mb-4">📄 CHI TIẾT ĐƠN HÀNG</h3>

<div class="mb-3">
    <strong>Mã đơn:</strong> @Model.MaDH <br />
    <strong>Ngày đặt:</strong>
    @Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") <br />
    <strong>Trạng thái:</strong>
    <span class="badge bg-warning text-dark">
        @Model.TrangThai
    </span>
</div>

<table class="table table-bordered align-middle text-center">
    <thead class="table-dark">
        <tr>
            <th>Sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Chi_Tiet_Don_Hang)
        {
            <tr>
                <td class="text-start">
                    @item.San_Pham.TenSP
                </td>
                <td>
                    @String.Format("{0:N0} đ", item.DonGia)
                </td>
                <td>
                    @item.SoLuong
                </td>
                <td class="text-danger fw-bold">
                    @String.Format("{0:N0} đ", item.ThanhTien)
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end">
    <a href="/Order_65134070/History"
       class="btn btn-outline-dark">
        ← Quay lại lịch sử đơn hàng
    </a>
</div>
