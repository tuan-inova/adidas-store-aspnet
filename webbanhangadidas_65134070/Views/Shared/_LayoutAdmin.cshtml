<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f4f6f9;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background-color: #212529;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

            .sidebar .brand {
                font-size: 18px;
                font-weight: bold;
                color: #fff;
                padding: 20px 16px;
                border-bottom: 1px solid #3d4144;
                text-align: center;
            }

            .sidebar nav {
                display: flex;
                flex-direction: column;
            }

            .sidebar a {
                color: #adb5bd;
                padding: 14px 20px;
                display: block;
                text-decoration: none;
                font-size: 15px;
                transition: all 0.3s;
            }

                .sidebar a i {
                    margin-right: 10px;
                    font-size: 1.1rem;
                }

                .sidebar a:hover,
                .sidebar a.active {
                    background-color: #dc3545;
                    color: #fff;
                }

        /* ===== CONTENT ===== */
        .content {
            margin-left: 240px;
            min-height: 100vh;
        }

        .topbar {
            background: #fff;
            padding: 12px 25px;
            border-bottom: 1px solid #dee2e6;
            position: sticky;
            top: 0;
            z-index: 999;
        }

            .topbar .title {
                font-weight: bold;
                font-size: 18px;
                color: #343a40;
            }
    </style>
</head>
<body>

    @* ===== CHỐNG TRUY CẬP TRÁI PHÉP ===== *@
    @if (Session["VaiTro"] == null || Session["VaiTro"].ToString() != "QuanLy")
    {
        Response.Redirect("/Account_65134070/Login");
    }

    <div class="sidebar shadow">
        <div class="brand">
            <i class="bi bi-shield-lock-fill me-2"></i> ADIDAS ADMIN
        </div>

        <nav class="mt-2">
            <a href="/AdminOrder_65134070" class="@(Request.Url.AbsolutePath.Contains("AdminOrder") && !Request.Url.AbsolutePath.Contains("Revenue") ? "active" : "")">
                <i class="bi bi-receipt"></i> Quản lý đơn hàng
            </a>

            <a href="/AdminOrder_65134070/RevenueByMonth" class="@(Request.Url.AbsolutePath.Contains("Revenue") ? "active" : "")">
                <i class="bi bi-bar-chart-line-fill"></i> Thống kê doanh thu
            </a>

            <a href="/SanPhamAdmin_65134070" class="@(Request.Url.AbsolutePath.Contains("SanPhamAdmin") ? "active" : "")">
                <i class="bi bi-box-seam"></i> Quản lý sản phẩm
            </a>

            @* MỚI: MỤC QUẢN LÝ TẤT CẢ KHÁCH HÀNG *@
            <a href="/CustomerAdmin_65134070" class="@(Request.Url.AbsolutePath.Contains("CustomerAdmin") ? "active" : "")">
                <i class="bi bi-people-fill"></i> Quản lý khách hàng
            </a>

            <div class="border-top border-secondary my-2 mx-3"></div>

            <a href="/">
                <i class="bi bi-arrow-left-circle"></i> Về trang người dùng
            </a>

            @using (Html.BeginForm("Logout", "Account_65134070", FormMethod.Post, new { @class = "mt-5" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link text-danger text-decoration-none">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            }
        </nav>
    </div>

    <div class="content">
        <div class="topbar d-flex justify-content-between align-items-center shadow-sm">
            <div class="title text-uppercase">@ViewBag.Title</div>
            <div class="user-info">
                <span class="text-muted me-2 small">Đang đăng nhập:</span>
                <span class="badge bg-dark">@Session["HoTen"]</span>
            </div>
        </div>

        <div class="p-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>