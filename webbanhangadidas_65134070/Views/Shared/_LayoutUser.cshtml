<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Adidas Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --adidas-red: #dc3545;
            --adidas-dark: #212529;
            --bg-light: #f4f7f6;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* ===== NAVBAR NÂNG CẤP ===== */
        .navbar {
            border-bottom: 3px solid var(--adidas-red) !important; /* Đường kẻ đỏ thương hiệu */
            transition: all 0.3s;
        }

        .navbar-brand {
            font-weight: 800 !important;
            letter-spacing: 1.5px;
            color: var(--adidas-dark) !important;
        }

        .nav-link {
            font-weight: 600;
            color: var(--adidas-dark) !important;
            padding: 0.5rem 1rem !important;
        }

            .nav-link:hover {
                color: var(--adidas-red) !important;
                transform: translateY(-2px);
                transition: 0.3s;
            }

        /* GIỮ NGUYÊN MINI CART HOVER CŨ VÀ LÀM ĐẸP HƠN */
        .mini-cart-wrapper {
            position: relative;
        }

            .mini-cart-wrapper .mini-cart {
                display: none;
                position: absolute;
                top: 130%;
                right: 0;
                width: 340px;
                max-height: 450px;
                overflow-y: auto;
                background: #fff;
                border-radius: 15px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.15); /* Đổ bóng sâu hơn */
                padding: 20px;
                opacity: 0;
                transform: translateY(15px);
                transition: all .3s ease;
                z-index: 1050;
                border: 1px solid #eee;
            }

            .mini-cart-wrapper:hover .mini-cart {
                display: block;
                opacity: 1;
                transform: translateY(0);
            }

        /* CART BADGE */
        .cart-badge {
            position: absolute;
            top: 0px;
            right: -5px;
            background-color: var(--adidas-red);
            color: white;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: bold;
        }

        /* FOOTER MÀU SẮC ĐỒNG BỘ */
        footer {
            background: #fff !important;
        }

            footer h5 {
                color: var(--adidas-dark);
                border-left: 4px solid var(--adidas-red);
                padding-left: 10px;
            }

            footer a:hover {
                color: var(--adidas-red) !important;
                padding-left: 5px;
                transition: 0.3s;
            }

        /* HIỆU ỨNG CARD SẢN PHẨM (Áp dụng cho RenderBody) */
        .product-card {
            border: none;
            border-radius: 15px;
            transition: 0.3s;
        }

            .product-card:hover {
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                transform: translateY(-5px);
            }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">ADIDAS STORE</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarUser">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarUser">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Category/1">Giày chạy bộ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Category/2">Giày thời trang</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Category/3">Quần áo nam</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Category/4">Quần áo nữ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Category/5">Phụ kiện</a></li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item mini-cart-wrapper me-3">
                        <a class="nav-link position-relative" href="/Cart_65134070">
                            <i class="bi bi-cart3 fs-4"></i>
                            <span class="cart-badge">@Html.Action("CartCount", "Cart_65134070")</span>
                        </a>

                        <div class="mini-cart shadow border-0">
                            @Html.Action("MiniCart", "Cart_65134070")
                            <div class="text-center mt-3 pt-2 border-top">
                                <a href="/Cart_65134070" class="btn btn-sm btn-danger w-100 rounded-pill fw-bold">
                                    XEM GIỎ HÀNG CHI TIẾT
                                </a>
                            </div>
                        </div>
                    </li>

                    @if (Session["MaTK"] == null)
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold" href="/Account_65134070/Login">
                                ĐĂNG NHẬP
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-bold text-primary" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> @Session["HoTen"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3">
                                <li><a class="dropdown-item" href="/Order_65134070/History">Lịch sử đơn hàng</a></li>
                                @if (Session["VaiTro"] != null && Session["VaiTro"].ToString() == "QuanLy")
                                {
                                    <li><a class="dropdown-item text-danger fw-bold" href="/SanPhamAdmin_65134070">Trang Quản Trị</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account_65134070", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4" style="min-height: 60vh;">
        @RenderBody()
    </div>

    <footer class="bg-white border-top pt-5 pb-3 mt-5 shadow-sm">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3 text-uppercase">Adidas Store</h5>
                    <p class="text-muted small">
                        Chuyên cung cấp các sản phẩm giày dép và phụ kiện Adidas chính hãng, chất lượng cao dành cho mọi lứa tuổi.
                    </p>
                    <div class="mt-3 bg-light p-3 rounded-3">
                        <p class="mb-1 fw-bold small text-secondary">HOTLINE HỖ TRỢ:</p>
                        <p class="fs-4 text-danger fw-bold mb-0">0123.456.789</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4 text-center text-md-start">
                    <h5 class="fw-bold mb-3 text-uppercase ps-md-3">More Info</h5>
                    <ul class="list-unstyled ps-md-3">
                        <li class="mb-3">
                            <a href="https://facebook.com/adidas" target="_blank" class="text-decoration-none text-dark d-flex align-items-center">
                                <i class="bi bi-facebook fs-4 me-3 text-primary"></i>
                                <span>Facebook chính thức</span>
                            </a>
                        </li>
                        <li class="mb-3">
                            <a href="https://instagram.com/adidas" target="_blank" class="text-decoration-none text-dark d-flex align-items-center">
                                <i class="bi bi-instagram fs-4 me-3 text-danger"></i>
                                <span>Theo dõi Instagram</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3 text-uppercase">Hỗ trợ khách hàng</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính sách bảo hành</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Chính sách đổi trả</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Hướng dẫn chọn size</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Hệ thống cửa hàng</a></li>
                    </ul>
                </div>
            </div>

            <hr class="my-4 text-muted">

            <div class="text-center">
                <small class="text-muted fw-bold">
                    © @DateTime.Now.Year - ADIDAS STORE | Đồ án Web - MSSV: 65134070
                </small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>