@model IEnumerable<webbanhangadidas_65134070.Models.San_Pham>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">📦 QUẢN LÝ SẢN PHẨM</h2>
    <a href="@Url.Action("Create", "SanPhamAdmin_65134070")" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
    </a>
</div>

@* Hiển thị thông báo phản hồi từ Controller *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:80px">Ảnh</th>
                        <th class="text-start">Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Kho</th>
                        <th>Loại</th>
                        <th>Trạng thái</th>
                        <th style="width:200px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.TrangThai == false ? "opacity-75 bg-light" : "")">
                            <td>
                                <img src="~/Images/@item.HinhAnh"
                                     class="rounded border"
                                     style="width:60px;height:60px;object-fit:cover"
                                     onerror="this.src='/Images/no-image.png'" />
                            </td>
                            <td class="text-start">
                                <div class="fw-bold text-dark">@item.TenSP</div>
                                <small class="text-muted d-block text-truncate" style="max-width: 200px;">@item.MoTa</small>
                            </td>
                            <td class="text-danger fw-bold">
                                @String.Format("{0:N0} đ", item.Gia)
                            </td>
                            <td>
                                <span class="badge @(item.SoLuongTon <= 5 ? "bg-danger" : "bg-info text-dark")">
                                    @item.SoLuongTon
                                </span>
                            </td>
                            <td><span class="text-secondary">@item.Loai_San_Pham.TenLoai</span></td>
                            <td>
                                @if (item.TrangThai == true)
                                {
                                    <span class="badge rounded-pill bg-success px-3">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">Ngừng bán</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group shadow-sm">
                                    <a href="@Url.Action("Edit", "SanPhamAdmin_65134070", new { id = item.MaSP })"
                                       class="btn btn-sm btn-warning" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="@Url.Action("Details", "SanPhamAdmin_65134070", new { id = item.MaSP })"
                                       class="btn btn-sm btn-info text-white" title="Xem">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @* Nút Xóa mềm - Ngừng kinh doanh *@
                                    <a href="@Url.Action("Delete", "SanPhamAdmin_65134070", new { id = item.MaSP })"
                                       class="btn btn-sm btn-outline-danger" title="Ngừng kinh doanh">
                                        <i class="bi bi-slash-circle"></i>
                                    </a>
                                    @* Nút Xóa vĩnh viễn - Đã sửa lỗi đường dẫn *@
                                    @using (Html.BeginForm("DeletePermanent", "SanPhamAdmin_65134070", new { id = item.MaSP }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Xóa vĩnh viễn"
                                                onclick="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN sản phẩm này không?')">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>