@model IEnumerable<webbanhangadidas_65134070.Models.ProductRevenueViewModel>
@{
    ViewBag.Title = "Chi tiết sản phẩm đã bán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-uppercase">📦 CHI TIẾT SẢN PHẨM ĐÃ BÁN (@ViewBag.ThoiGian)</h2>
    <a href="@Url.Action("RevenueByMonth")" class="btn btn-outline-secondary btn-sm shadow-sm">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-primary text-dark">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th class="text-center">Ngày & Giờ bán</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end pe-4">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">#@p.MaSP</td>
                                <td class="fw-bold text-dark">@p.TenSP</td>
                                <td class="text-center">
                                    @* Hiển thị Ngày/Tháng/Năm Giờ:Phút:Giây *@
                                    @(p.NgayGioBan.HasValue ? p.NgayGioBan.Value.ToString("dd/MM/yyyy HH:mm:ss") : "---")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@p.SoLuongBan</span>
                                </td>
                                <td class="text-end pe-4 text-danger fw-bold">
                                    @String.Format("{0:N0} đ", p.TongTienSP)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào trong thời gian này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>