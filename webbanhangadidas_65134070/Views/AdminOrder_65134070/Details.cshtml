@model webbanhangadidas_65134070.Models.Don_Hang

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">📑 CHI TIẾT ĐƠN #@Model.MaDH</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm mb-4 border-0">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">Thông tin khách hàng</h5>
                <p class="mb-1"><strong>Khách hàng:</strong> @Model.Tai_Khoan.HoTen</p>
                @* Hiển thị SĐT từ cột GhiChu và Địa chỉ từ cột DiaChiGiao *@
                <p class="mb-1"><strong>Số điện thoại:</strong> <span class="text-danger fw-bold">@Model.GhiChu</span></p>
                <p class="mb-1"><strong>Địa chỉ nhận hàng:</strong> @Model.DiaChiGiao</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">Trạng thái & Thao tác</h5>
                <p class="mb-1"><strong>Ngày đặt:</strong> @(Model.NgayDat.HasValue ? Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</p>
                <p class="mb-3">
                    <strong>Trạng thái:</strong>
                    <span class="badge @(Model.TrangThai == "Hoàn tất" ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                        @Model.TrangThai
                    </span>
                </p>

                @* NÚT DUYỆT ĐƠN *@
                @if (Model.TrangThai == "Chờ duyệt")
                {
                    using (Html.BeginForm("Approve", "AdminOrder_65134070", new { id = Model.MaDH }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-lg shadow-sm" onclick="return confirm('Xác nhận duyệt đơn hàng này và trừ tồn kho sản phẩm?')">
                            <i class="bi bi-check-circle-fill me-1"></i> DUYỆT ĐƠN HÀNG
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="fw-bold mb-0">Danh sách sản phẩm</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-start ps-4">Sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th class="text-end pe-4">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Chi_Tiet_Don_Hang)
                {
                    <tr>
                        <td class="text-start ps-4 fw-bold">@item.San_Pham.TenSP</td>
                        <td>@String.Format("{0:N0} đ", item.DonGia)</td>
                        <td>@item.SoLuong</td>
                        <td class="text-end pe-4 text-danger fw-bold">@String.Format("{0:N0} đ", item.ThanhTien)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="3" class="text-end fw-bold fs-5">TỔNG CỘNG:</td>
                    <td class="text-end pe-4 text-danger fw-bold fs-5">@String.Format("{0:N0} đ", Model.TongTien)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>