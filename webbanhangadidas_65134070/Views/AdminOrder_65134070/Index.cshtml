@model IEnumerable<webbanhangadidas_65134070.Models.Don_Hang>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-uppercase"><i class="bi bi-cart-check-fill me-2"></i>Quản lý đơn hàng</h2>
    <div class="text-muted">Tổng số: <strong>@Model.Count()</strong> đơn hàng</div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#@item.MaDH</td>
                            <td>
                                <div class="fw-bold">@item.Tai_Khoan.HoTen</div>
                                <small class="text-muted">SĐT: @item.GhiChu</small>
                            </td>
                            <td>@item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                @{
                                    
                                    string badgeClass = "bg-secondary"; // Mặc định xám
                                    if (item.TrangThai == "Hoàn tất") { badgeClass = "bg-success"; } // Xanh lá
                                    else if (item.TrangThai == "Chờ duyệt" || item.TrangThai == "Đã duyệt") { badgeClass = "bg-warning text-dark"; } // Vàng
                                    else if (item.TrangThai == "Đã hủy") { badgeClass = "bg-danger"; } // Đỏ
                                }
                                <span class="badge @badgeClass rounded-pill px-3 py-2" style="min-width: 100px;">
                                    @item.TrangThai
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("Details", new { id = item.MaDH })"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-eye-fill me-1"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* HIỆU ỨNG KHI DI CHUỘT QUA DÒNG */
    .table tbody tr:hover {
        background-color: rgba(220, 53, 69, 0.05) !important;
        transition: 0.3s;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 15px 10px;
    }
</style>