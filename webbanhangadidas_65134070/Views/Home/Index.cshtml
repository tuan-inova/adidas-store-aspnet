@model IEnumerable<webbanhangadidas_65134070.Models.San_Pham>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div id="mainBanner"
     class="carousel slide carousel-fade mb-5"
     data-bs-ride="carousel"
     data-bs-interval="4000"
     data-bs-pause="false">

    <div class="carousel-indicators">
        @* CẬP NHẬT: Còn 4 ảnh (0 đến 3) *@
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="2"></button>
        <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="3"></button>
    </div>

    <div class="carousel-inner rounded-4 shadow-lg overflow-hidden">
        <div class="carousel-item active">
            <div class="banner-overlay"></div>
            <img src="~/Images/banner.jpg" class="d-block w-100 banner-img" />
            <div class="carousel-caption text-start">
                <h1 class="display-3 fw-bolder text-uppercase">ADIDAS STORE</h1>
                <p class="fs-4 fw-light">Hiệu năng – Phong cách – Đổi mới</p>
                <a href="#sanpham" class="btn btn-danger btn-lg rounded-pill px-5 shadow">Mua ngay</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/Images/banner1.jpg" class="d-block w-100 banner-img" />
        </div>

        <div class="carousel-item">
            <img src="~/Images/banner2.jpg" class="d-block w-100 banner-img" />
        </div>

        <div class="carousel-item">
            @* CẬP NHẬT: Đây là ảnh cuối cùng mới *@
            <img src="~/Images/banner3.jpg" class="d-block w-100 banner-img" />
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon p-3 bg-dark rounded-circle"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#mainBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon p-3 bg-dark rounded-circle"></span>
    </button>
</div>

@* MỚI: THANH TÌM KIẾM SẢN PHẨM *@
<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h5 class="fw-bold mb-3 text-uppercase">Tìm kiếm sản phẩm</h5>
            @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "input-group shadow-sm" }))
            {
                <input type="text" name="searchString" class="form-control border-danger rounded-start-pill ps-4 py-2"
                       placeholder="Bạn đang tìm mẫu giày nào? (vd: Ultraboost, Gazelle...)"
                       value="@Request.QueryString["searchString"]">
                <button class="btn btn-danger rounded-end-pill px-4" type="submit">
                    <i class="bi bi-search me-1"></i> TÌM KIẾM
                </button>
            }
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="category-box p-4 rounded-4 shadow-sm text-center border-bottom border-5 border-danger bg-white h-100">
                <i class="bi bi-lightning-charge fs-1 text-danger"></i>
                <h4 class="fw-bold mt-3">GIÀY CHẠY BỘ</h4>
                <p class="text-muted">Hiệu năng tối đa cho runner chuyên nghiệp.</p>
                <a href="/Home/Category/1" class="btn btn-sm btn-outline-dark rounded-pill">Khám phá ngay</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="category-box p-4 rounded-4 shadow-sm text-center border-bottom border-5 border-dark bg-white h-100">
                <i class="bi bi-sunglasses fs-1 text-dark"></i>
                <h4 class="fw-bold mt-3 text-uppercase">Thời trang</h4>
                <p class="text-muted">Định hình phong cách đường phố của bạn.</p>
                <a href="/Home/Category/2" class="btn btn-sm btn-outline-dark rounded-pill">Khám phá ngay</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="category-box p-4 rounded-4 shadow-sm text-center border-bottom border-5 border-secondary bg-white h-100">
                <i class="bi bi-backpack fs-1 text-secondary"></i>
                <h4 class="fw-bold mt-3 text-uppercase">Phụ kiện</h4>
                <p class="text-muted">Hoàn thiện outfit của bạn mỗi ngày.</p>
                <a href="/Home/Category/5" class="btn btn-sm btn-outline-dark rounded-pill">Khám phá ngay</a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4 px-2">
        <div>
            <h2 id="sanpham" class="fw-bold mb-0 text-uppercase">Sản phẩm nổi bật</h2>
            <div class="bg-danger" style="height: 4px; width: 60px; border-radius: 2px;"></div>
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2">Adidas New Arrival 2026</span>
    </div>

    @* MỚI: Hiển thị thông báo nếu không có kết quả tìm kiếm *@
    @if (Model.Count() == 0)
    {
        <div class="alert alert-light text-center border py-5 rounded-4 shadow-sm">
            <i class="bi bi-emoji-frown fs-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Rất tiếc, không tìm thấy sản phẩm nào phù hợp!</h4>
            <a href="/Home/Index" class="btn btn-outline-danger btn-sm mt-2 rounded-pill">Xem tất cả sản phẩm</a>
        </div>
    }

    <div class="row g-4">
        @foreach (var sp in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 product-card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                    <span class="position-absolute top-0 start-0 m-3 badge bg-dark rounded-pill shadow-sm" style="z-index: 5;">Hot 🔥</span>

                    <div class="product-img-wrapper p-3">
                        <img src="~/Images/@sp.HinhAnh" class="card-img-top" alt="@sp.TenSP" />
                    </div>

                    <div class="card-body text-center pt-0 d-flex flex-column">
                        <h6 class="fw-bold text-truncate" title="@sp.TenSP">@sp.TenSP</h6>

                        <p class="text-danger fw-bold fs-5 mb-3">
                            @String.Format("{0:N0} đ", sp.Gia)
                        </p>

                        <div class="mt-auto d-grid gap-2">
                            <a href="/Home/Details/@sp.MaSP" class="btn btn-outline-dark btn-sm rounded-pill transition">
                                <i class="bi bi-search me-1"></i> Chi tiết
                            </a>

                            @using (Html.BeginForm("Add", "Cart_65134070", new { id = sp.MaSP }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm rounded-pill shadow-sm transition w-100">
                                    <i class="bi bi-cart-plus me-1"></i> Thêm giỏ hàng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* SLIDER */
    .banner-img {
        height: 500px;
        object-fit: cover;
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, rgba(0,0,0,0.6), transparent);
        z-index: 1;
    }

    .carousel-caption {
        z-index: 2;
        bottom: 25%;
    }

    /* SEARCH INPUT */
    .form-control:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    /* CATEGORY BOXES */
    .category-box {
        transition: all 0.3s ease;
        border: 1px solid #f1f1f1;
    }

        .category-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    /* PRODUCT CARD */
    .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
        }

    .product-img-wrapper {
        overflow: hidden;
        background-color: #fff;
    }

    .product-card img {
        height: 200px;
        object-fit: contain;
        transition: transform 0.5s ease;
    }

    .product-card:hover img {
        transform: scale(1.1);
    }

    /* BUTTONS */
    .transition {
        transition: 0.3s ease;
    }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #000;
            transform: scale(1.05);
        }
</style>